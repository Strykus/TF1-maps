global function RunoffGroundFog_Init
struct {
 bool started=false
 array<int> handles
} file

void function RunoffGroundFog_Init()
{
 if ( GetMapName() != "mp_tf1_runoff" ) return
 PrecacheParticleSystem($"env_ground_fog_256_lite")
 PrecacheParticleSystem($"env_ground_fog_256")
 PrecacheParticleSystem($"env_ground_fog_far")
 thread RunoffGroundFog_Start()
}

void function RunoffGroundFog_StartAt( asset effect, vector position, vector angles )
{
 int index = GetParticleSystemIndex( effect )
 if ( index < 0 ) return
 file.handles.append( StartParticleEffectInWorldWithHandle( index, position, angles ) )
}

