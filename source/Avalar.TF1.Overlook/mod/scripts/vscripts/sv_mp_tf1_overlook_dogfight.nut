struct
{
    bool preview
    bool started
} file

void function TF1OverlookDogfight_Init()
{
    if ( GetMapName() != "mp_tf1_overlook" )
        return
    PrecacheModel( OVERLOOK_STRATON )
    PrecacheModel( OVERLOOK_HORNET )
    PrecacheModel( $"models/vehicle/hornet/hornet_fighter_afterburner1.mdl" )
    PrecacheModel( $"models/vehicle/hornet/hornet_fighter_afterburner2.mdl" )
    PrecacheModel( $"models/vehicle/straton/straton_imc_gunship_afterburner.mdl" )
    PrecacheParticleSystem( OVERLOOK_STRATON_JET )
    PrecacheParticleSystem( OVERLOOK_HORNET_JET )
    PrecacheParticleSystem( OVERLOOK_HORNET_REAR )
    file.preview = Dev_CommandLineHasParm( "-tf1-overlook-flight-preview" )
    if ( file.preview )
        AddCallback_OnClientConnected( TF1OverlookDogfight_PreviewJoin )
    else
        AddCallback_GameStateEnter( eGameState.Playing, TF1OverlookDogfight_Start )
}

void function TF1OverlookDogfight_PreviewJoin( entity player )
{
    if ( file.started )
        return
    file.started = true
    TF1OverlookDogfight_Start()
}

void function TF1OverlookDogfight_Start()
{
    thread TF1OverlookDogfight_Run()
}

void function TF1OverlookDogfight_Run()
{
    wait 5.0
    vector origin = <0, 0, 6100>
    while ( ( file.preview || GetGameState() == eGameState.Playing ) )
    {
        for ( int i = 0; i < 40 && ( file.preview || GetGameState() == eGameState.Playing ); i++ )
        {
            int index = RandomInt( 3 )
            vector angles = <0, 0, 0>
            angles.y = float( RandomInt( 360 ) )
            thread TF1OverlookDogfight_Play( origin, angles, index )
            float interval = 4.0 + float( RandomInt( 3 ) )
            if ( i >= 20 )
                interval = 8.0 + float( RandomInt( 13 ) )
            wait interval
            if ( i == 19 )
                wait 20.0
        }
        wait 40.0
    }
}

void function TF1OverlookDogfight_Play( vector origin, vector heading, int variant )
{
    array<vector> targetRoute = [OVERLOOK_ST_DOGFIGHT_TARGET_1, OVERLOOK_ST_DOGFIGHT_TARGET_2, OVERLOOK_ST_DOGFIGHT_TARGET_3][variant]
    array<vector> chaseRoute = [OVERLOOK_ST_DOGFIGHT_PERSUER_1, OVERLOOK_ST_DOGFIGHT_PERSUER_2, OVERLOOK_ST_DOGFIGHT_PERSUER_3][variant]
    array<vector> targetPoses = [OVERLOOK_ST_DOGFIGHT_TARGET_1_ANGLES, OVERLOOK_ST_DOGFIGHT_TARGET_2_ANGLES, OVERLOOK_ST_DOGFIGHT_TARGET_3_ANGLES][variant]
    array<vector> chasePoses = [OVERLOOK_ST_DOGFIGHT_PERSUER_1_ANGLES, OVERLOOK_ST_DOGFIGHT_PERSUER_2_ANGLES, OVERLOOK_ST_DOGFIGHT_PERSUER_3_ANGLES][variant]
    float step = [OVERLOOK_ST_DOGFIGHT_TARGET_1_STEP, OVERLOOK_ST_DOGFIGHT_TARGET_2_STEP, OVERLOOK_ST_DOGFIGHT_TARGET_3_STEP][variant]
    // The TF1 root-motion coordinates are scaled to 38% for TF2 networking.
    // Scale the clocks too so the fighters keep the retail world speed.
    step *= 0.38
    entity target = TF1OverlookDogfight_SpawnOnRoute( OVERLOOK_STRATON, targetRoute, targetPoses, origin, heading )
    thread TF1OverlookDogfight_FlyShip( target, targetRoute, targetPoses, step, origin, heading, "Straton" )
    wait 1.0
    if ( !file.preview && GetGameState() != eGameState.Playing )
        return
    entity pursuer = TF1OverlookDogfight_SpawnOnRoute( OVERLOOK_HORNET, chaseRoute, chasePoses, origin, heading )
    waitthread TF1OverlookDogfight_FlyShip( pursuer, chaseRoute, chasePoses, step, origin, heading, "Hornet" )
}

entity function TF1OverlookDogfight_SpawnOnRoute( asset model, array<vector> route, array<vector> poses, vector origin, vector heading )
{
    vector start = TF1OverlookDogfight_RoutePoint( origin, heading, route[0] )
    vector angles = AnglesCompose( heading, poses[0] )
    entity mover = CreateScriptMover( start, angles )
    entity ship = CreatePropDynamic( model, start, angles, 0 )
    ship.EnableRenderAlways()
    ship.SetFadeDistance( 36000 )
    ship.SetParent( mover )
    ship.SetLocalOrigin( <0,0,-90> )
    ship.SetLocalAngles( <0,90,90> )
    thread TF1OverlookDogfight_FighterExhaust( ship, model == OVERLOOK_HORNET )
    thread TF1OverlookDogfight_CleanupMover( ship, mover )
    return ship
}

void function TF1OverlookDogfight_FighterExhaust( entity ship, bool hornet )
{
    ship.EndSignal( "OnDestroy" )
    array<entity> effects
    OnThreadEnd( function() : (effects) {
        foreach ( entity fx in effects )
            if ( IsValid( fx ) ) fx.Destroy()
    } )
    int jet = GetParticleSystemIndex( hornet ? OVERLOOK_HORNET_JET : OVERLOOK_STRATON_JET )
    array<string> tags = ["L_exhaust_rear_1", "R_exhaust_rear_1", "L_exhaust_front_1", "R_exhaust_front_1"]
    if ( hornet ) tags.append( "C_exhaust_rear_1" )
    foreach ( string tag in tags )
    {
        int attachment = ship.LookupAttachment( tag )
        if ( attachment <= 0 ) continue
        int effect = tag == "C_exhaust_rear_1" ? GetParticleSystemIndex( OVERLOOK_HORNET_REAR ) : jet
        entity fx = StartParticleEffectOnEntity_ReturnEntity( ship, effect, FX_PATTACH_POINT_FOLLOW, attachment )
        fx.FXEnableRenderAlways()
        effects.append( fx )
    }
    printt( "TF1_OVERLOOK_EXHAUST", hornet ? "Hornet" : "Straton", effects.len() )
    WaitForever()
}

void function TF1OverlookDogfight_FlyShip( entity ship, array<vector> route, array<vector> poses, float step, vector origin, vector heading, string audit = "" )
{
    ship.EndSignal( "OnDestroy" )
    waitthread TF1OverlookDogfight_FollowRoute( ship.GetParent(), route, poses, step, audit, origin, heading )
    if ( IsValid( ship ) )
    {
        ship.Destroy()
    }
}

void function TF1OverlookDogfight_FollowRoute( entity mover, array<vector> route, array<vector> poses, float step, string audit, vector origin = <0,0,0>, vector heading = <0,0,0> )
{
    mover.EndSignal( "OnDestroy" )
    float start = Time()
    float duration = step * ( route.len() - 1 )
    float idle = 0.0
    float longestIdle = 0.0
    float maxFrameDistance = 0.0
    vector previous = mover.GetOrigin()
    float sampledAt = start
    while ( true )
    {
        float now = Time()
        float remaining = duration - ( now - start )
        float distance = Distance( mover.GetOrigin(), previous )
        if ( now > sampledAt && now - start > 0.4 && remaining > 0.4 )
        {
            idle = distance < 0.5 ? idle + now - sampledAt : 0.0
            longestIdle = max( longestIdle, idle )
            maxFrameDistance = max( maxFrameDistance, distance )
        }
        previous = mover.GetOrigin()
        sampledAt = now
        float lookAhead = min( 0.14, max( remaining, 0.05 ) )
        float sample = min( ( now - start + lookAhead ) / step, float( route.len() - 1 ) )
        mover.NonPhysicsMoveTo( TF1OverlookDogfight_RoutePoint( origin, heading, TF1OverlookDogfight_RouteSample( route, sample ) ), lookAhead, 0.0, 0.0 )
        vector targetAngles = AnglesCompose( heading, TF1OverlookDogfight_RouteAngles( poses, sample, <0,0,0> ) )
        vector currentAngles = mover.GetAngles()
        targetAngles.x = TF1OverlookDogfight_ClosestAngle( currentAngles.x, targetAngles.x )
        targetAngles.y = TF1OverlookDogfight_ClosestAngle( currentAngles.y, targetAngles.y )
        targetAngles.z = TF1OverlookDogfight_ClosestAngle( currentAngles.z, targetAngles.z )
        mover.NonPhysicsRotateTo( targetAngles, lookAhead, 0.0, 0.0 )
        if ( sample >= float( route.len() - 1 ) )
        {
            wait lookAhead
            break
        }
        wait 0
    }
    printt( "TF1_OVERLOOK_FLIGHT_DONE", audit, "idle", longestIdle, "duration", Time() - start, "end_error",
        Distance( mover.GetOrigin(), TF1OverlookDogfight_RoutePoint( origin, heading, route[ route.len() - 1 ] ) ) )
}

void function TF1OverlookDogfight_CleanupMover( entity ship, entity mover )
{
    ship.EndSignal( "OnDestroy" )
    OnThreadEnd( function() : (mover) {
        if ( IsValid( mover ) ) mover.Destroy()
    } )
    WaitForever()
}

vector function TF1OverlookDogfight_RoutePoint( vector origin, vector heading, vector offset )
{
    return origin + AnglesToForward( heading ) * offset.x - AnglesToRight( heading ) * offset.y + Vector( 0, 0, offset.z )
}

float function TF1OverlookDogfight_ClosestAngle( float current, float target )
{
    if ( current > 180.0 ) current -= 360.0
    if ( current < -180.0 ) current += 360.0
    float delta = target - current
    if ( delta > 180.0 ) delta -= 360.0
    if ( delta < -180.0 ) delta += 360.0
    return current + delta
}

vector function TF1OverlookDogfight_RouteSample( array<vector> route, float sample )
{
    int i = minint( int( sample ), route.len() - 2 )
    vector a = route[ maxint( i - 1, 0 ) ]
    vector b = route[i]
    vector c = route[i + 1]
    vector d = route[ minint( i + 2, route.len() - 1 ) ]
    float t = sample - i
    float t2 = t * t
    return ( b * 2.0 + ( c - a ) * t + ( a * 2.0 - b * 5.0 + c * 4.0 - d ) * t2 + ( -a + b * 3.0 - c * 3.0 + d ) * t2 * t ) * 0.5
}

vector function TF1OverlookDogfight_RouteAngles( array<vector> poses, float sample, vector reference )
{
    int i = minint( int( sample ), poses.len() - 2 )
    vector a = poses[i]
    vector b = poses[i + 1]
    b.x = TF1OverlookDogfight_ClosestAngle( a.x, b.x )
    b.y = TF1OverlookDogfight_ClosestAngle( a.y, b.y )
    b.z = TF1OverlookDogfight_ClosestAngle( a.z, b.z )
    vector result = a + ( b - a ) * ( sample - i )
    result.x = TF1OverlookDogfight_ClosestAngle( reference.x, result.x )
    result.y = TF1OverlookDogfight_ClosestAngle( reference.y, result.y )
    result.z = TF1OverlookDogfight_ClosestAngle( reference.z, result.z )
    return result
}

