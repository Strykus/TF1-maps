      }
    },
    {
      "Path": "cl_mp_tf1_airbase_lighting.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "After": "TF1Port_mp_tf1_airbase_Init",
        "Destroy": "TF1Port_mp_tf1_airbase_Shutdown"
      }
    },
    {
      "Path": "sv_mp_tf1_airbase_turrets.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "Before": "TF1Port_mp_tf1_airbase_Turrets_Precache",
        "After": "TF1Port_mp_tf1_airbase_Turrets_Init"
      }
    },
    {
      "Path": "cl_mp_tf1_airbase_miles.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "After": "TF1Port_mp_tf1_airbase_Miles_Init",
        "Destroy": "TF1Port_mp_tf1_airbase_Miles_Shutdown"
      }
    },
    {
      "Path": "sv_mp_tf1_airbase_lifecycle.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "After": "TF1Port_mp_tf1_airbase_ServerInit"
      }
    },
    {
      "Path": "cl_mp_tf1_airbase_tower.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "Before": "TF1AirbaseTower_ClientPrecache",
