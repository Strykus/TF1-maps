        "Destroy": "TF1AirbaseTower_ClientShutdown"
      }
    },
    {
      "Path": "sv_mp_tf1_airbase_tower.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "Before": "TF1AirbaseTower_ServerPrecache",
        "After": "TF1AirbaseTower_ServerInit"
      }
    },
    {
      "Path": "sv_mp_tf1_airbase_fastball.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "After": "TF1AirbaseFastball_Init"
      }
