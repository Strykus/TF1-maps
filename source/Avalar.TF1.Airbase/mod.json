        "Destroy": "TF1AirbaseStaticSky_Shutdown"
      }
    },
    {
      "Path": "sv_mp_tf1_airbase_static_sky.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "Before": "TF1AirbaseStaticSky_ServerPrecache"
      }
    },
    {
      "Path": "sv_mp_tf1_airbase_evac.nut",
      "RunOn": "SERVER && MP",
      "ServerCallback": {
        "After": "TF1Evac_mp_tf1_airbase_Init"
      }
    },
    {
      "Path": "cl_mp_tf1_airbase_forklift.nut",
      "RunOn": "CLIENT && MP",
      "ClientCallback": {
        "Before": "TF1AirbaseForklift_Precache",
        "After": "TF1AirbaseForklift_Init",
        "Destroy": "TF1AirbaseForklift_Shutdown"
      }
    },
    {
      "ServerCallback": {
        "Before": "TF1AirbaseForklift_ServerPrecache"
      },
      "RunOn": "SERVER && MP",
      "Path": "sv_mp_tf1_airbase_forklift.nut"
